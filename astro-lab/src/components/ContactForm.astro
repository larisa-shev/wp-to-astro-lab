---
/**
 * Replacement for the Contact Form 7 form. Markup, ids, labels and placeholders mirror the CF7 output
 * (checked against the rendered WordPress page) so the migrated stylesheet applies unchanged; the
 * `wpcf7*` class names are kept on purpose for that reason. Submission is handled by the local form
 * backend (`server/form-server.mjs`), see src/scripts/contact-form.ts.
 */
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || 'http://127.0.0.1:4322/api/contact';
---

<div class="wpcf7" id="nt-contact-form-wrap">
  <div class="screen-reader-response">
    <p role="status" aria-live="polite" aria-atomic="true" data-form-live></p>
  </div>
  <form
    action={endpoint}
    method="post"
    class="wpcf7-form init"
    aria-label="Contact form"
    novalidate
    data-contact-form
    data-endpoint={endpoint}
  >
    <!-- Honeypot: hidden from humans and assistive tech, bots fill it in. -->
    <div style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
      <label for="nt-website">Leave this field empty</label>
      <input type="text" id="nt-website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="nt-form-grid">
      <div class="nt-form-field">
        <p>
          <label for="nt-your-name">Full Name <span class="nt-required" aria-hidden="true">*</span></label><br />
          <span class="wpcf7-form-control-wrap" data-name="your-name">
            <input size="40" maxlength="400" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required" id="nt-your-name" autocomplete="name" aria-required="true" aria-invalid="false" placeholder="e.g., Alex Morgan" value="" type="text" name="your-name" />
          </span>
        </p>
      </div>
      <div class="nt-form-field">
        <p>
          <label for="nt-your-email">Work Email <span class="nt-required" aria-hidden="true">*</span></label><br />
          <span class="wpcf7-form-control-wrap" data-name="your-email">
            <input size="40" maxlength="400" class="wpcf7-form-control wpcf7-email wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-email" id="nt-your-email" autocomplete="email" aria-required="true" aria-invalid="false" placeholder="alex.morgan@company.example" value="" type="email" name="your-email" />
          </span>
        </p>
      </div>
      <div class="nt-form-field nt-form-field--full">
        <p>
          <label for="nt-your-subject">Project Scope or Inquiry Topic <span class="nt-required" aria-hidden="true">*</span></label><br />
          <span class="wpcf7-form-control-wrap" data-name="your-subject">
            <input size="40" maxlength="400" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required" id="nt-your-subject" aria-required="true" aria-invalid="false" placeholder="e.g., Cloud Platform Consolidation &amp; Cost Audit" value="" type="text" name="your-subject" />
          </span>
        </p>
      </div>
      <div class="nt-form-field nt-form-field--full">
        <p>
          <label for="nt-your-message">Technical Context &amp; Timeline <span class="nt-required" aria-hidden="true">*</span></label><br />
          <span class="wpcf7-form-control-wrap" data-name="your-message">
            <textarea cols="40" rows="4" maxlength="2000" class="wpcf7-form-control wpcf7-textarea wpcf7-validates-as-required" id="nt-your-message" aria-required="true" aria-invalid="false" placeholder="Briefly describe your current architecture, key bottlenecks, and target delivery window." name="your-message"></textarea>
          </span>
        </p>
      </div>
      <div class="nt-form-actions nt-form-field--full">
        <p>
          <input class="wpcf7-form-control wpcf7-submit has-spinner nt-btn nt-btn--primary" type="submit" value="Request Architecture Consultation" />
        </p>
        <p class="nt-form-privacy">
          Demo environment notice: submissions are routed exclusively to the local Mailpit container (127.0.0.1:8025) and never leave your machine.
        </p>
      </div>
    </div>
    <div class="wpcf7-response-output" aria-hidden="true"></div>
  </form>
</div>

<script>
  import '../scripts/contact-form';
</script>
