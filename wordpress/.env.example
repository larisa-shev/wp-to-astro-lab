# =============================================================================
# WP-to-Astro Lab — Local Docker Environment Variables Template
# Copy this file to `.env` before starting Docker containers:
#   Copy-Item .env.example .env
# Never commit the actual `.env` file to version control.
# =============================================================================

# Local HTTP Port for WordPress (bound to 127.0.0.1:8001)
WP_PORT=8001
WP_SITE_URL=http://localhost:8001
WP_SITE_TITLE="NovaTech Solutions Lab"

# Local Admin Account (for local development only — set your own in .env)
WP_ADMIN_USER=lab_admin
WP_ADMIN_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY
WP_ADMIN_EMAIL=admin@novatech.local

# MariaDB 11.4 Settings (for local development only — set your own in .env)
DB_NAME=wp_astro_lab
DB_USER=wp_lab_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
WP_TABLE_PREFIX=wp_
WP_DEBUG=0

# Mailpit Web UI Port (bound strictly to 127.0.0.1:8025; SMTP 1025 is internal-only)
MAILPIT_UI_PORT=8025
